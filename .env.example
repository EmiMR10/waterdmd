# Base de datos PostgreSQL en Neon, Supabase u otro proveedor compatible.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Crea esta cadena segura con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-por-un-secreto-largo"

# OAuth App de GitHub. Callback local: http://localhost:3000/api/auth/callback/github
# Callback en Vercel: https://tu-dominio.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
